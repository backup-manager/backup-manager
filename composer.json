{
  "name": "backup-manager/backup-manager",
  "description": "A framework agnostic database backup manager with user-definable procedures and support for S3, Dropbox, FTP, SFTP, and more with drivers for popular frameworks.",
  "license": "MIT",
  "authors": [
    {
      "name": "Shawn McCool",
      "email": "shawn@heybigname.com",
      "homepage": "http://heybigname.com/"
    },
    {
      "name": "Mitchell van Wijngaarden",
      "email": "mitchell@kooding.nl",
      "homepage": "http://heybigname.com/"
    }
  ],
  "require": {
    "php": ">=7.4",
    "league/flysystem": "^1.1.4 || ^2.1.1 || ^3.35.3",
    "symfony/process": "^5.4.51 || ^6.4.33 || ^7.4.5 || ^8.0.5"
  },
  "require-dev": {
    "league/flysystem-async-aws-s3": "^2.0 || ^3.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "league/flysystem-ftp": "^3.0",
    "league/flysystem-google-cloud-storage": "^3.0",
    "league/flysystem-sftp-v3": "^3.0",
    "league/flysystem-webdav": "^3.0",
    "phpspec/phpspec": "^7.5 || ^8.0",
    "spatie/flysystem-dropbox": "^2.0 || ^3.0"
  },
  "suggest": {
    "league/flysystem-async-aws-s3": "AsyncAws S3 adapter support (Flysystem 2/3).",
    "league/flysystem-aws-s3-v3": "AWS S3 adapter support.",
    "league/flysystem-ftp": "FTP adapter support (Flysystem 2/3; built into Flysystem 1).",
    "league/flysystem-google-cloud-storage": "Google Cloud Storage adapter support (Flysystem 2/3).",
    "league/flysystem-rackspace": "Rackspace adapter support (Flysystem 1 only).",
    "league/flysystem-sftp": "SFTP adapter support (Flysystem 1/2).",
    "league/flysystem-sftp-v3": "SFTP adapter support (Flysystem 3).",
    "league/flysystem-webdav": "WebDAV adapter support.",
    "mhetreramesh/flysystem-backblaze": "B2 adapter support (Flysystem 1 only).",
    "spatie/flysystem-dropbox": "Dropbox adapter support.",
    "srmklive/flysystem-dropbox-v2": "Dropbox API v2 adapter support (Flysystem 1 only).",
    "superbalist/flysystem-google-storage": "Google Cloud Storage adapter support (Flysystem 1 only)."
  },
  "autoload": {
    "psr-4": {
      "BackupManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "spec\\BackupManager\\": "spec/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "3.x-dev"
    }
  }
}
