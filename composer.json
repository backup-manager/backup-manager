{
  "name": "backup-manager/backup-manager",
  "description": "A framework agnostic database backup manager with user-definable procedures and support for S3, Dropbox, FTP, SFTP, and more with drivers for popular frameworks.",
  "license": "MIT",
  "authors": [
    {
      "name": "Shawn McCool",
      "email": "shawn@heybigname.com",
      "homepage": "http://heybigname.com/"
    },
    {
      "name": "Mitchell van Wijngaarden",
      "email": "mitchell@kooding.nl",
      "homepage": "http://heybigname.com/"
    }
  ],
  "require": {
    "php": "^8.2",
    "league/flysystem": "^3.35.3",
    "symfony/process": "^6.4.33 || ^7.4.5 || ^8.0.5"
  },
  "require-dev": {
    "league/flysystem-async-aws-s3": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "league/flysystem-ftp": "^3.0",
    "league/flysystem-google-cloud-storage": "^3.0",
    "league/flysystem-sftp-v3": "^3.0",
    "league/flysystem-webdav": "^3.0",
    "phpspec/phpspec": "^8.0",
    "spatie/flysystem-dropbox": "^3.0"
  },
  "suggest": {
    "league/flysystem-async-aws-s3": "AsyncAws S3 adapter support.",
    "league/flysystem-aws-s3-v3": "AWS S3 adapter support.",
    "league/flysystem-ftp": "FTP adapter support.",
    "league/flysystem-google-cloud-storage": "Google Cloud Storage adapter support.",
    "league/flysystem-sftp-v3": "SFTP adapter support.",
    "league/flysystem-webdav": "WebDAV adapter support.",
    "spatie/flysystem-dropbox": "Dropbox adapter support."
  },
  "autoload": {
    "psr-4": {
      "BackupManager\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "spec\\BackupManager\\": "spec/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "4.x-dev"
    }
  }
}
